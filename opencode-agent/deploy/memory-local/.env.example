# Mem0 本地验证环境变量
# 用法：cp .env.example .env，填入真实 API key

# ── Postgres ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mem0_local_dev_change_me

# ── Mem0 app ──
# JWT_SECRET 用于签发 admin token（AUTH_DISABLED=true 时可不填，但 compose 里有 :? 校验，随便给个值）
JWT_SECRET=mem0_local_jwt_secret_dev_only

# 本地验证关鉴权，由 gateway 层（X-User-Id / X-Agent-Id）做身份隔离
AUTH_DISABLED=true

# ── DeepSeek（LLM 事实抽取）──
# 项目 .env 里已有，可复用同一个 key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── 通义千问（Embedding）──
# 阿里云控制台 → DashScope → API-KEY
# 模型 text-embedding-v3 走 OpenAI 兼容模式：https://dashscope.aliyuncs.com/compatible-mode/v1
# 新用户有免费额度，足够本地验证
TONGYI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
