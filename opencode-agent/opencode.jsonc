{
  "$schema": "https://opencode.ai/config.json",

  // DeepSeek provider
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}",
        "baseURL": "https://api.deepseek.com/v1"
      }
    }
  },
  "model": "deepseek/deepseek-v4-flash",

  // Read-only mode: deny file writes & shell, allow read/search
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "read": "allow",
    "grep": "allow",
    "glob": "allow"
  }
}
