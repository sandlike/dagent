# 后端环境变量（拷贝为 .env 后填写）
# 数据库（腾讯云 MySQL，需先创建库 agenthub）
MYSQL_HOST=sh-cynosdbmysql-grp-l9wk8j8e.sql.tencentcdb.com
MYSQL_PORT=26471
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=agenthub

# JWT 密钥（生产请改成随机长串）
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# 服务端口
PORT=3000

# K8s（可选；留空时部署走 Mock，前端开发不阻塞）
# 不填则使用本地 ~/.kube/config
# KUBECONFIG=/path/to/kubeconfig

# 部署实例的默认 namespace（各环境隔离）
# INSTANCE_NAMESPACE=opencode-test

# CORS 允许的前端来源（逗号分隔多域名）
# CORS_ORIGIN=http://localhost:5173

# 镜像 Registry（opencode 实例镜像仓库前缀，如 registry.cn-hangzhou.aliyuncs.com/citics_lwj）
# IMAGE_REGISTRY=
# sidecar 镜像全名（默认 opencode-sidecar:latest）
# SIDECAR_IMAGE=

# PVC 配置（阿里云云盘最小 20Gi）
# PVC_SIZE=20Gi
# StorageClass（集群无默认 SC 时必须指定）
# STORAGE_CLASS_NAME=alicloud-disk-essd

# 镜像拉取凭据（私有 registry；三选一）
# 方式1：复用已存在的 secret
# IMAGE_PULL_SECRET=acr-auth
# 方式2：自动创建（需全部提供）
# IMAGE_PULL_REGISTRY=registry.cn-hangzhou.aliyuncs.com
# IMAGE_PULL_USER=your_user
# IMAGE_PULL_PASSWORD=your_password

